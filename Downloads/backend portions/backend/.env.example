# =============================================================================
# backend/.env.example — copy to backend/.env for LOCAL development only.
# =============================================================================
# WHY this file exists: the real .env is gitignored because it holds a secret
# that grants the ability to mint valid login tokens for your entire user base.
# Committing it would let anyone forge an educator session. This example carries
# the SHAPE of the config with no real values, so a teammate can start in one
# command:  cp .env.example .env
#
# On Render you do NOT use this file — set the same variables in the dashboard's
# Environment tab (or via render.yaml). Render never reads a .env from the repo.
# =============================================================================

# --- Auth -------------------------------------------------------------------
# Leave AUTH_ENABLED=false for a no-login local demo. On Render keep it true.
AUTH_ENABLED=false

# Supabase -> Settings -> API -> "Project URL". No trailing slash.
# ALWAYS REQUIRED. Used for the `iss` claim check, and to locate the public
# JWKS endpoint for projects on Supabase's current signing scheme.
SUPABASE_PROJECT_URL=

# ONLY for Supabase projects created BEFORE May 2025, which sign tokens with
# the legacy HS256 shared secret.
#   Settings -> API Keys -> JWT Signing Keys -> legacy secret -> Reveal
#
# Projects created AFTER 1 May 2025 sign with an RSA key (RS256) and have NO
# secret to configure. LEAVE THIS EMPTY. Verification then uses the PUBLIC key
# at <SUPABASE_PROJECT_URL>/auth/v1/.well-known/jwks.json — nothing secret is
# stored anywhere, which is the security win of the newer scheme.
#
# Unsure which you have? Paste a real access token into jwt.io and read `alg`:
# HS256 -> fill this in.  RS256 -> leave it blank.
# Full walkthrough with error tables: docs/SUPABASE_ENV_ELI5.md
#
# SECURITY: a real value here lets its holder mint a valid EDUCATOR login for
# every user in your app. Never commit it, never put it in frontend/.env, and
# never expose it as a VITE_* variable (those are compiled into the public
# JavaScript bundle every visitor downloads).
SUPABASE_JWT_SECRET=

# --- CORS -------------------------------------------------------------------
# Comma-separated. The frontend dev server origin is already allowed by default.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Engines ----------------------------------------------------------------
# detection: heuristic (default, no model) | transformer (needs torch + RAM) | mock
DETECTION_ENGINE=heuristic
# fact-check: duckduckgo (default, keyless) | llm (needs GROQ_API_KEY) | mock
FACT_CHECK_ENGINE=duckduckgo
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Limits -----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
FACT_CHECK_TIMEOUT=15

# --- Runtime ----------------------------------------------------------------
# Render injects PORT. Set it locally only if 8000 is taken.
PORT=8000
