# =============================================================================
# .env.production — loaded ONLY by `vite build` (mode = production)
# =============================================================================
# WHY THIS FILE EXISTS
# --------------------
# Vite loads `.env` for every mode, then `.env.<mode>` on top of it, with the
# mode-specific file winning per variable. That layering is the problem: a flag
# set in `.env` for local convenience is silently carried into production builds.
#
# The specific trap this file defuses:
#   VITE_USE_DEV_PROXY=true makes the app call SAME-ORIGIN /api/* paths, which
#   Vite's DEV server forwards to the backend. It is a development-only
#   convenience. If it survives into a production bundle, the deployed site
#   requests /api/v1/fact-check from the static host — which has no backend and
#   no proxy — so every AI call 404s. To the user it looks like the backend is
#   down, and the browser console shows a 404 on your own domain rather than
#   anything resembling "configuration".
#
# Pinning it to false here means a production build cannot inherit that flag,
# whatever a developer happens to have in their local `.env`.
# =============================================================================

VITE_USE_DEV_PROXY=false

# -----------------------------------------------------------------------------
# Lock the backend URL OUT of production builds.
# -----------------------------------------------------------------------------
# `.env` holds VITE_API_BASE_URL=http://127.0.0.1:8000 for local development.
# Without this line, `npm run build` would bake LOCALHOST into the deployed
# bundle. The site would then load correctly, and every AI call would fail —
# because 127.0.0.1 means "the machine running the browser", i.e. the visitor's
# own laptop, not yours.
#
# Setting it empty here means a production build is built with the URL
# deliberately UNSET. You then supply the real one either:
#   - at build time:  VITE_API_BASE_URL=https://your-api.onrender.com npx vite build
#     (a real shell environment variable overrides .env files — verified)
#   - at runtime:     set apiBaseUrl in the deployed config.js      <- no rebuild
# If neither is done, the app fails with an explicit "not configured" message
# instead of silently calling the wrong host and blaming the network.
VITE_API_BASE_URL=
