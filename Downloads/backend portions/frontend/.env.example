# =============================================================================
# frontend/.env.example — the SHAPE of the config, no real values.
# =============================================================================
# WHY: `.env` is gitignored because a deployed build embeds these values in a
# public JavaScript bundle. This example is what a teammate copies to start:
#     cp .env.example .env
# Only VITE_-prefixed variables reach the browser. Never put the Supabase
# `service_role` key or the Supabase JWT secret here — both are server-side only.
# =============================================================================

# Your Render backend URL. No trailing slash.
# e.g. https://truthguard-backend.onrender.com
# Local development default. NOTE: `vite build` does NOT use this value —
# .env.production pins VITE_API_BASE_URL empty so a production build can never
# bake "localhost" into the deployed bundle. For a static host with no build
# step (Netlify Drop), set apiBaseUrl in public/config.js instead — it is read
# at runtime and needs no rebuild.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase -> Settings -> API. Leave both empty to run the offline demo.
VITE_SUPABASE_URL=
# The **anon public** key. NEVER the service_role key.
VITE_SUPABASE_ANON_KEY=

# true = offline demo (no Supabase, pre-authenticated as an educator).
# false = real signup/login + RLS-protected scan_logs.
VITE_DEMO_MODE=true

# Seconds the submit button locks after a 429.
VITE_RATE_LIMIT_COOLDOWN_SECONDS=10
